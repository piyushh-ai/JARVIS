# Environment Variables Template
# Copy this file to .env.local and provide real values for local development.
# Do not commit .env.local or insert real credentials into .env.example.

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/jarvis?retryWrites=true&w=majority

# ESP32 controller bearer-token hashing pepper
ESP32_TOKEN_PEPPER=replace-with-long-random-pepper-secret

# HTTP-only user session hashing secret
SESSION_SECRET=replace-with-long-random-session-secret

# AI provider credentials (Gemini is required for ESP32 audio parsing)
GEMINI_API_KEY=replace-with-gemini-api-key
# Optional voice parser model overrides
# GEMINI_VOICE_MODEL=gemini-2.5-flash-lite
# GEMINI_VOICE_FALLBACK_MODEL=gemini-2.5-flash

# Optional wake-word behavior
ESP32_VOICE_WAKE_WORD=jarvis
ESP32_VOICE_REQUIRE_WAKE_WORD=true

# Other AI provider keys for the text assistant (optional)
# MISTRAL_API_KEY=replace-with-mistral-api-key
# GROQ_API_KEY=replace-with-groq-api-key
# OPENAI_API_KEY=replace-with-openai-api-key
# AI_PROVIDER=gemini
# AI_MODEL=gemini-3.1-flash-lite
# AI_TIMEOUT_MS=20000

# Optional client API base path
# NEXT_PUBLIC_API_BASE_URL=/api
