# Environment variables
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/jarvis?retryWrites=true&w=majority
ESP32_TOKEN_PEPPER=replace-with-long-random-pepper-secret
SESSION_SECRET=replace-with-long-random-session-secret

# Groq only
GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3
GROQ_STT_LANGUAGE=en

# ESP32 voice tuning
ESP32_VOICE_WAKE_WORD=jarvis
ESP32_VOICE_REQUIRE_WAKE_WORD=true
ESP32_VOICE_SESSION_IDLE_MIN=15
ESP32_WAKE_WORD_SIMILARITY=0.6

NEXT_PUBLIC_API_BASE_URL=/api
