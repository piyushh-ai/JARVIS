# Environment Variables Template
# Copy this file to .env.local and provide real values for local development.
# Do not commit .env.local or insert real credentials into .env.example.
# For Vercel deployments, add MONGODB_URI in Project Settings -> Environment Variables.
#
# Next.js convention:
# - Server-only variables: VAR_NAME=value (never expose secrets with NEXT_PUBLIC_)
# - Client-exposed variables: NEXT_PUBLIC_VAR_NAME=value

# Required (Server-only): MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/jarvis?retryWrites=true&w=majority

# ESP32 controller provisioning uses authenticated Home owner/admin browser sessions (no static admin secret)

# Recommended (Server-only): HMAC pepper for hashing ESP32 bearer tokens
ESP32_TOKEN_PEPPER=replace-with-long-random-pepper-secret

# Recommended (Server-only): HMAC secret for hashing HTTP-only user session tokens
SESSION_SECRET=replace-with-long-random-session-secret

# Optional (Client): Override API base path (leave unset on Vercel to use same-origin /api)
# NEXT_PUBLIC_API_BASE_URL=/api
